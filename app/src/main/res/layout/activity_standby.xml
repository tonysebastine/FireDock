<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/standbyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Ambient Vivid Aurora / Radial Glow (Dynamic IPS multi-stop glow) -->
    <View
        android:id="@+id/standbyAmbientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Container for Burn-In Prevention Drift -->
    <FrameLayout
        android:id="@+id/standbyContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ======================================================== -->
        <!-- MODE 0: Dual Widget Split (iOS StandBy Classic)          -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/viewDualWidgets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <!-- LEFT WIDGET: Giant Digital Clock + Calendar -->
            <LinearLayout
                android:id="@+id/widgetLeft"
                android:layout_width="0dp"
                android:layout_height="330dp"
                android:layout_weight="1"
                android:layout_marginEnd="28dp"
                android:background="@drawable/glass_panel"
                android:padding="28dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true"
                    android:gravity="center">

                    <TextClock
                        android:id="@+id/standbyClockHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="96sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"
                        android:shadowColor="#80000000"
                        android:shadowDy="4"
                        android:shadowRadius="16" />

                    <TextClock
                        android:id="@+id/standbyClockAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#AAFFFFFF"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextClock
                    android:id="@+id/standbyDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="#DDFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

                <!-- Status pill: Wi-Fi + Connected Audio -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/cc_glass_tile"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/standbyWifiIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_wifi"
                        android:tint="#FFFFFFFF"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/standbyStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Online • FireDock"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT WIDGET: Apple Watch Analog Dial + Weather Glance -->
            <FrameLayout
                android:id="@+id/widgetRightContainer"
                android:layout_width="0dp"
                android:layout_height="330dp"
                android:layout_weight="1"
                android:layout_marginStart="28dp"
                android:background="@drawable/glass_panel"
                android:padding="20dp">

                <com.appletv.launcher.StandByAnalogClock
                    android:id="@+id/standbyAnalogClock"
                    android:layout_width="290dp"
                    android:layout_height="290dp"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:id="@+id/standbyGlanceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/cc_glass_tile"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_margin="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_weather_cloud"
                        android:tint="#FFFF9F0A"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/standbyWeatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="24°C • Fair"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- MODE 1: Full-Screen Minimalist Ultra-Clean Digital Face  -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/viewFullScreenDigital"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true"
                android:gravity="center">

                <TextClock
                    android:id="@+id/fullBigClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="170sp"
                    android:fontFamily="sans-serif-thin"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="false"
                    android:shadowColor="#99000000"
                    android:shadowDy="6"
                    android:shadowRadius="24" />

                <TextClock
                    android:id="@+id/fullBigAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="#AAFFFFFF"
                    android:textSize="36sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextClock
                android:id="@+id/fullBigDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="#DDFFFFFF"
                android:textSize="30sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- MODE 2: IPS Aurora Horizon (Apple tvOS Specular Glow)    -->
        <!-- Rich, high dynamic range layout crafted for IPS panels   -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/viewAuroraHorizon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:visibility="gone">

            <!-- Left: Gigantic 140sp Clean Typography -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/auroraClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="135sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.05"
                    android:includeFontPadding="false"
                    android:shadowColor="#AA000000"
                    android:shadowDy="6"
                    android:shadowRadius="24" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/auroraDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEEE • MMMM d"
                        android:format24Hour="EEEE • d MMMM"
                        android:textColor="#E6FFFFFF"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/auroraAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/cc_glass_tile"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="LIVE"
                        android:textColor="#30D158"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: Tri-Pill Widget Stack with specular frosted tiles -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:layout_marginStart="40dp"
                android:orientation="vertical">

                <!-- Card 1: Today's Calendar Glance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/glass_panel"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="#FF3B30"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Schedule"
                            android:textColor="#99FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Upcoming Events"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 2: Weather & Conditions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/glass_panel"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_weather_cloud"
                        android:tint="#0A84FF"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weather Condition"
                            android:textColor="#99FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24°C • Pleasant Breeze"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 3: FireDock Now Playing & Audio Output -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/glass_panel"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_music"
                        android:tint="#BF5AF2"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audio System"
                            android:textColor="#99FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/auroraAudioText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TV Speakers • Spatial Ready"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- MODE 3: Apple Chronograph Studio                        -->
        <!-- Bold centered circular chronometer for IPS wide viewing  -->
        <!-- ======================================================== -->
        <FrameLayout
            android:id="@+id/viewChronoStudio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <com.appletv.launcher.StandByAnalogClock
                    android:id="@+id/chronoStudioClock"
                    android:layout_width="380dp"
                    android:layout_height="380dp" />

                <TextClock
                    android:id="@+id/chronoStudioDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="#E6FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </FrameLayout>

        <!-- Hint bar at bottom (subtle fade out) -->
        <TextView
            android:id="@+id/standbyHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="◀ / ▶ Switch Style • Menu: Night Mode • Any Key to Exit"
            android:textColor="#66FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.03" />

    </FrameLayout>
</FrameLayout>
