<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/cc_glass_tile"
    android:focusable="true"
    android:clickable="true"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/pillIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:duplicateParentState="true"
        android:tint="@drawable/pill_text"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/pillTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@drawable/pill_text"
            android:singleLine="true"
            android:ellipsize="end"
            android:duplicateParentState="true" />

        <TextView
            android:id="@+id/pillSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="9.5sp"
            android:textColor="@drawable/pill_text_dim"
            android:singleLine="true"
            android:ellipsize="end"
            android:duplicateParentState="true" />
    </LinearLayout>
</LinearLayout>
