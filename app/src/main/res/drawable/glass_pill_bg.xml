<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-layered Apple tvOS specular frosted glass pill capsule -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_button_focused" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#14FFFFFF" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
